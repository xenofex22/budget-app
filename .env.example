# Budget account
BUDGET_USERNAME=your_username
# SHA-256 hex digest of your password, never the plaintext password
BUDGET_PASSWORD_HASH=replace_with_sha256_hex
# Optional second account. Keep the real password out of GitHub and store only
# its SHA-256 hash in Vercel.
BUDGET_SECONDARY_USERNAME=second_username
BUDGET_SECONDARY_PASSWORD_HASH=replace_with_sha256_hex
BUDGET_SECONDARY_DEFAULT_CURRENCY=TRY

# Random secret, ideally 32+ bytes
SESSION_SECRET=replace_with_long_random_secret

# Write-only iPhone Shortcut token
SMS_DEVICE_TOKEN=replace_with_long_random_device_token

# Upstash Redis REST credentials (Vercel/Upstash integration may use KV_ names)
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=...
# Alternative names also supported:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
